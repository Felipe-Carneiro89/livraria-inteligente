# Alternativa ao MCP para executar os scripts fora da sessão do agente.
DATABASE_URL=
# URL do servidor MCP Supabase e token fornecidos pelo usuário, se disponíveis.
SUPABASE_MCP_URL=
SUPABASE_MCP_TOKEN=

# Copie este exemplo para .env e preencha somente a chave do provedor escolhido.
# O agente usa DATABASE_URL; a conexão MCP do editor não é herdada pelo Python.
LLM_PROVIDER=openai
# Informe um modelo disponível na sua conta; nenhuma chamada ocorre sem chave.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
